{
  "name": "M8 小練習② 採買便條摘要",
  "nodes": [
    {
      "parameters": {},
      "name": "手動執行",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "f0",
              "name": "memo",
              "value": "週末要買牛奶2瓶、雞蛋1盒，衛生紙家裡還有，不用買。",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "name": "便條原文",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ '<便條>' + $json.memo + '</便條>' }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "你是家裡的採買小幫手。把 <便條> 裡「要買」的東西列成 items（name 品名、qty 數量）。只能列便條裡寫要買的，不准自己加；寫不用買的不要列。看不懂就 needsReview 設成 true。"
            }
          ]
        }
      },
      "name": "整理便條",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.5-flash-lite",
        "options": {
          "temperature": 0.2
        }
      },
      "name": "Gemini模型",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        380,
        220
      ]
    },
    {
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\n  \"items\": [\n    {\n      \"name\": \"品名\",\n      \"qty\": \"數量\"\n    }\n  ],\n  \"needsReview\": false\n}"
      },
      "name": "格式解析器",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        540,
        220
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c0",
              "leftValue": "={{ !$json.output.needsReview && $json.output.items.length >= 1 && $json.output.items.every(i => $('便條原文').first().json.memo.includes(i.name)) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "品項都在原文嗎",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        0
      ]
    }
  ],
