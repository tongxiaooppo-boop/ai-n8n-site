{
  "name": "M5 主線 股",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 7
            }
          ]
        }
      },
      "name": "排程",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://openapi.twse.com.tw/v1/exchangeReport/STOCK_DAY_ALL",
        "options": {}
      },
      "name": "抓股價",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c0",
              "leftValue": "={{ ['2330','2317'].includes($json.Code) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "挑自選股",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "f0",
              "name": "kind",
              "value": "stock",
              "type": "string"
            },
            {
              "id": "f1",
              "name": "label",
              "value": "={{ $json.Name + ' 收盤' }}",
              "type": "string"
            },
            {
              "id": "f2",
              "name": "value",
              "value": "={{ $json.ClosingPrice === '' ? null : Number($json.ClosingPrice) }}",
              "type": "number"
            },
            {
              "id": "f3",
              "name": "dataDate",
              "value": "={{ (Number($json.Date.slice(0,3)) + 1911) + '-' + $json.Date.slice(3,5) + '-' + $json.Date.slice(5,7) }}",
              "type": "string"
            },
            {
              "id": "f4",
              "name": "status",
              "value": "={{ $json.ClosingPrice === '' ? 'missing' : 'ok' }}",
              "type": "string"
            },
            {
              "id": "f5",
              "name": "fetchedAt",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "name": "整理",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "",
          "mode": "list"
        },
        "options": {}
      },
      "name": "存快照",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        880,
        0
      ]
    }
  ],
  "connections": {
    "排程": {
      "main": [
        [
          {
            "node": "抓股價",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "抓股價": {
      "main": [
        [
          {
            "node": "挑自選股",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "挑自選股": {
      "main": [
        [
          {
            "node": "整理",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "整理": {
      "main": [
        [
          {
            "node": "存快照",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}