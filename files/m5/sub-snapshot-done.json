{
  "name": "M5 快照寫入",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "name": "子流程入口",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "csv",
        "options": {}
      },
      "name": "轉成CSV",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "=/home/node/.n8n-files/snap/{{ $('子流程入口').first().json.kind }}.csv",
        "options": {}
      },
      "name": "寫檔",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        440,
        0
      ]
    }
  ],
  "connections": {
    "子流程入口": {
      "main": [
        [
          {
            "node": "轉成CSV",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "轉成CSV": {
      "main": [
        [
          {
            "node": "寫檔",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}