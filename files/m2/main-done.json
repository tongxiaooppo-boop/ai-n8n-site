        "jsonOutput": "{\"data\": [{\"Date\": \"1151117\", \"Code\": \"2330\", \"Name\": \"假想甲\", \"ClosingPrice\": \"2170.00\", \"Change\": \"-45.0000\"}, {\"Date\": \"1151117\", \"Code\": \"2317\", \"Name\": \"假想乙\", \"ClosingPrice\": \"219.00\", \"Change\": \"0.5000\"}, {\"Date\": \"1151117\", \"Code\": \"9999\", \"Name\": \"假想丙\", \"ClosingPrice\": \"\", \"Change\": \"0.0000\"}, {\"Date\": \"1151117\", \"Code\": \"1101\", \"Name\": \"假想丁\", \"ClosingPrice\": \"30.00\", \"Change\": \"1.0000\"}]}",
