        "fieldToSplitOut": "data",
        "options": {}
      }
    },
    {
      "name": "挑自選股",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.Code }}",
              "rightValue": "2330",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.Code }}",
              "rightValue": "2317",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      }
    },
    {
      "name": "整理",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "dataDate",
              "value": "={{ (Number($json.Date.slice(0,3))+1911) + '-' + $json.Date.slice(3,5) + '-' + $json.Date.slice(5,7) }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "code",
              "value": "={{ $json.Code }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "name",
              "value": "={{ $json.Name }}",
              "type": "string"
            },
            {
              "id": "a4",
              "name": "close",
              "value": "={{ $json.ClosingPrice === '' ? null : Number($json.ClosingPrice) }}",
              "type": "number"
            },
            {
              "id": "a5",
              "name": "change",
              "value": "={{ $json.ClosingPrice === '' ? null : Number($json.Change) }}",
              "type": "number"
            },
            {
              "id": "a6",
              "name": "valid",
              "value": "={{ $json.ClosingPrice !== '' }}",
              "type": "boolean"
            }
          ]
        },
        "options": {}
      }
    }
