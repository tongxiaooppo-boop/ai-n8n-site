{
  "name": "結業範例 旅費匯率提醒",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 8
            }
          ]
        }
      },
      "name": "每天早上",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://cpx.cbc.gov.tw/api/OpenData/FTDOpenData_Day",
        "options": {
          "timeout": 20000
        }
      },
      "name": "抓匯率",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "maxItems": 1,
        "keep": "lastItems"
      },
      "name": "最新一筆",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.NTD_USD }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            },
            {
              "id": "c0",
              "leftValue": "={{ $json.NTD_USD ? Number($json.NTD_USD) : null }}",
              "rightValue": 30,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "低於目標？",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "<你的 Chat ID>",
        "text": "={{ '美元匯率 ' + $json.NTD_USD + '（' + $json['日期'] + ' 央行資料，不是銀行牌告），低於你設的目標' }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "name": "傳通知",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        880,
        0
      ]
    }
  ],
  "connections": {
    "每天早上": {
      "main": [
        [
          {
            "node": "抓匯率",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "抓匯率": {
      "main": [
        [
          {
            "node": "最新一筆",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "最新一筆": {
      "main": [
        [
          {
            "node": "低於目標？",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "低於目標？": {
      "main": [
        [
          {
            "node": "傳通知",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}